{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": ""
  },
  "Jwt": {
    "Issuer": "solucao-backend",
    "Audience": "solucao-clients",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Fiscal": {
    "Provider": "simulated",
    "Environment": "homologation",
    "Series": 1
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000",
      "app://."
    ]
  }
}
