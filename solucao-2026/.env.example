# Copie para .env (NUNCA commite o .env) e preencha antes de subir a produção:
#   docker compose -f docker-compose.prod.yml up -d --build

# Senha do superuser do Postgres (admin do banco)
POSTGRES_ADMIN_PASSWORD=

# Senha do role da aplicação (solucao_app). Após a PRIMEIRA subida, aplique:
#   ALTER ROLE solucao_app PASSWORD '<este valor>'
# (o init script cria o role com senha de dev)
POSTGRES_APP_PASSWORD=

# Segredo do JWT — 64+ caracteres aleatórios. Gere com:
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 64 | % {[char]$_})
#   Linux:      openssl rand -base64 48
JWT_KEY=

# Origem do dashboard em produção (para o CORS), ex.: https://app.seudominio.com.br
DASHBOARD_ORIGIN=

# homologation | production (mantém homologation enquanto o provider fiscal for simulado)
FISCAL_ENVIRONMENT=homologation
